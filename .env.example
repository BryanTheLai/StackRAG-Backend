# Backend Environment Configuration

# Chat / RAG Model Selection (gemini, openai, fireworks, custom)
CHAT_PROVIDER=openai
OPENAI_API_KEY=your-openai-or-fireworks-api-key
OPENAI_CHAT_MODEL=gpt-5.6-luna
# To use DeepSeek v4 0731 on Fireworks AI for cheap & powerful reasoning:
# OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
# OPENAI_CHAT_MODEL=accounts/fireworks/models/deepseek-v4-0731

GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.5-lite

# Decoupled Vision Model (qwen, openai, gemini, custom)
# Allows using vision models like Qwen 3.7 Plus for PDF image OCR while using DeepSeek/GPT for chat reasoning
VISION_PROVIDER=qwen
VISION_MODEL=qwen-3.7-plus
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_API_KEY=your-vision-api-key

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

MAX_CONCURRENT_INGESTIONS=2
DOCUMENT_PROCESS_MAX_ATTEMPTS=3
APP_DOMAIN=http://localhost:5173

TEST_EMAIL=test@example.com
TEST_PASSWORD=your-test-password